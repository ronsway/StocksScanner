# Default provider when app sends aiProvider=auto (or does not send aiProvider)
# Can be: anthropic or openai
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible settings (OpenAI, OpenRouter, Groq, Together, etc.)
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

PORT=8787
